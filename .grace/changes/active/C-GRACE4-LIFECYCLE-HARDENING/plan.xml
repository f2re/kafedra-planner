<GraceChangePlan graceVersion="4.0" status="approved">
  <C-GRACE4-LIFECYCLE-HARDENING>
    <IntentSummary>Harden the existing GRACE 4 contour so branch stages, repository-wide scope, exact-SHA checks and terminal archiving form one closed lifecycle.</IntentSummary>
    <BaselineAssertions>
      <MustExist><Value>.github/workflows/grace.yml</Value></MustExist>
      <MustExist><Value>scripts/grace-governance.mjs</Value></MustExist>
      <MustExist><Value>scripts/github/grace-durable-gate.mjs</Value></MustExist>
      <MustExist><Value>scripts/github/grace-merge-gate.mjs</Value></MustExist>
      <MustVerify><Module>M-GRACE-GOVERNANCE</Module></MustVerify>
      <MustVerify><Module>M-CI-GATE</Module></MustVerify>
      <MustVerify><Module>M-DATABASE</Module></MustVerify>
    </BaselineAssertions>
    <TargetAssertions>
      <MustExist><Value>docs/GRACE_GOVERNANCE.md</Value></MustExist>
      <MustContain><File>docs/GRACE_GOVERNANCE.md</File><Text>Terminal archive transition</Text></MustContain>
      <MustContain><File>.github/workflows/grace.yml</File><Text>GRACE post-merge / merge-gate</Text></MustContain>
      <MustContain><File>scripts/grace-governance.mjs</File><Text>archiveCandidate</Text></MustContain>
      <MustVerify><Module>M-GRACE-GOVERNANCE</Module></MustVerify>
      <MustVerify><Module>M-CI-GATE</Module></MustVerify>
      <MustVerify><Module>M-DATABASE</Module></MustVerify>
      <MustPassCommand><Command>node --test tests/grace-governance.test.mjs</Command></MustPassCommand>
      <MustPassCommand><Command>bash scripts/ci/grace-db-gate.sh "${GRACE_BASE_REF:-origin/main}"</Command></MustPassCommand>
      <MustPassCommand><Command>npm run check</Command></MustPassCommand>
      <MustPassCommand><Command>npm run docs:check</Command></MustPassCommand>
    </TargetAssertions>
    <DurableScope>
      <GraphAnchors>
        <M-GRACE-GOVERNANCE />
        <M-CI-GATE />
        <M-DATABASE />
        <M-MIGRATION-RUNNER />
        <M-BACKUP />
        <DF-GRACE-BRANCH />
        <DF-DATABASE-UPGRADE />
      </GraphAnchors>
      <VerificationAnchors>
        <V-M-GRACE-GOVERNANCE />
        <V-M-CI-GATE />
        <V-M-DATABASE />
        <V-M-MIGRATION-RUNNER />
        <V-M-BACKUP />
      </VerificationAnchors>
    </DurableScope>
    <ObservedWriteScope>
      <Glob>.grace/**</Glob>
      <File>.github/workflows/grace.yml</File>
      <File>docs/GRACE_GOVERNANCE.md</File>
      <File>scripts/grace-governance.mjs</File>
      <File>tests/grace-governance.test.mjs</File>
    </ObservedWriteScope>
    <ImplementationPlan>
      <T-001>
        <Title>Model branch lifecycle stages and repository-wide governed surfaces</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria><Criterion>The policy distinguishes draft, planned and implementation stages and fails closed for writes outside one approved scope.</Criterion></AcceptanceCriteria>
        <Verification><Command>node --test tests/grace-governance.test.mjs</Command></Verification>
      </T-001>
      <T-002>
        <Title>Make terminal archive transition immutable</Title>
        <DependsOn><T-001 /></DependsOn>
        <AcceptanceCriteria><Criterion>Only a complete active-to-archive move with identical content except matching root terminal statuses is accepted.</Criterion></AcceptanceCriteria>
        <Verification><Command>node --test tests/grace-governance.test.mjs</Command></Verification>
      </T-002>
      <T-003>
        <Title>Separate branch, pull-request and post-merge check contexts</Title>
        <DependsOn><T-001 /></DependsOn>
        <AcceptanceCriteria><Criterion>Each event publishes one unambiguous contract/database/aggregate set while PR merge eligibility remains exact-SHA.</Criterion></AcceptanceCriteria>
        <Verification><Command>npm run check</Command></Verification>
      </T-003>
      <T-004>
        <Title>Document the two-PR implementation and archive lifecycle</Title>
        <DependsOn><T-002 /><T-003 /></DependsOn>
        <AcceptanceCriteria><Criterion>Operator documentation explains implementation merge, post-merge verification, archive-only PR and final zero-active state.</Criterion></AcceptanceCriteria>
        <Verification><Command>npm run docs:check</Command></Verification>
      </T-004>
    </ImplementationPlan>
  </C-GRACE4-LIFECYCLE-HARDENING>
</GraceChangePlan>
