    <ImplementationPlan>
      <T-001>
        <Title>kafedra-flow-intake: fix lifecycle loading, empty and stale-detail states</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>The view changes through one explicit action and never modifies persisted plan lifecycle.</Criterion>
          <Criterion>Search and ordinary filters survive; an absent selected plan never remains visible in detail.</Criterion>
          <Criterion>Loading, no-result, repeated selection, archive and restore synchronization remain deterministic.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/lifecycle.test.mjs</Command></Verification>
      </T-001>
      <T-002>
        <Title>kafedra-design: specify persistent desktop-first segmented hierarchy</Title>
        <DependsOn><T-001 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>The segment is permanently visible before ordinary filters and the compatibility select is not duplicated visually.</Criterion>
          <Criterion>Text, surface, border, aria-selected and visible focus express selection independently of color.</Criterion>
          <Criterion>Desktop 1440x900, constrained desktop 1024x768 and 44 pixel targets are specified; mobile is explicitly excluded as a separate mode.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run design:check</Command></Verification>
      </T-002>
      <T-003>
        <Title>kafedra-motion: use restrained interruptible selection feedback</Title>
        <DependsOn><T-002 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Only background, border, shadow and text color transition for 120–180 milliseconds.</Criterion>
          <Criterion>prefers-reduced-motion is instant and data loading, state and focus never wait for animation.</Criterion>
          <Criterion>No mobile navigation, gesture or mobile-specific transition is introduced.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run design:check</Command></Verification>
      </T-003>
      <T-004>
        <Title>kafedra-feature: implement a thin accessible adapter over the lifecycle select</Title>
        <DependsOn><T-003 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>The adapter hides the select, emits its existing change event and performs no direct API call or persistence.</Criterion>
          <Criterion>Click, Enter, Space, Left, Right, Home and End update the existing status-filtered request path.</Criterion>
          <Criterion>Mode-specific empty text updates without observer loops or a second lifecycle store.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/plans-lifecycle-segment.test.mjs</Command></Verification>
      </T-004>
      <T-005>
        <Title>kafedra-design-audit: independently inspect desktop geometry, focus and reduced motion</Title>
        <DependsOn><T-004 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>The audit records PASS, REVISE or BLOCK for desktop, constrained desktop, keyboard, focus, empty state and reduced motion.</Criterion>
          <Criterion>The audit confirms that no separate mobile state machine, breakpoint behavior or mobile-specific control was added.</Criterion>
          <Criterion>No blocker or major finding remains before final tests.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run design:check</Command></Verification>
      </T-005>
      <T-006>
        <Title>kafedra-tests: prove server status, preserved context and compatibility</Title>
        <DependsOn><T-005 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Unit tests cover deterministic modes, keyboard order, one hidden state bridge, no direct API/storage and no observer loop.</Criterion>
          <Criterion>Focused desktop Playwright covers click, keyboard, server status, preserved search, stale detail, empty state, 44 pixels, reduced motion and page overflow at the two accepted desktop sizes.</Criterion>
          <Criterion>The focused test is included in the normal plans browser command as desktop-only; existing repository mobile regressions remain unchanged and are not expanded by P1.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm test</Command><Command>npx playwright test tests/browser/plans-lifecycle-segment.spec.mjs --project=desktop</Command></Verification>
      </T-006>
