    <ImplementationPlan>
      <T-001>
        <Title>kafedra-flow-intake: lock desktop lifecycle states and stale-detail behavior</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Viewing active/archive is one action and never changes persisted plan status.</Criterion>
          <Criterion>Search and ordinary filters survive; the existing controller clears or replaces invalid selected detail.</Criterion>
          <Criterion>Loading/error states are not rewritten as empty states.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/lifecycle.test.mjs</Command></Verification>
      </T-001>
      <T-002>
        <Title>kafedra-design and kafedra-motion: define persistent desktop segment</Title>
        <DependsOn><T-001 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Selection is text-, shape- and accessibility-state-first, with 44 px targets and visible focus.</Criterion>
          <Criterion>The control exists only from 721 px and introduces no mobile-specific state.</Criterion>
          <Criterion>Motion is optional, restrained and fully removed under reduced motion.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run design:check</Command></Verification>
      </T-002>
      <T-003>
        <Title>kafedra-feature: bridge segmented tabs to existing lifecycle select</Title>
        <DependsOn><T-002 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>The existing select remains the compatibility source and receives normal input/change events.</Criterion>
          <Criterion>Click, Enter, Space, arrows, Home and End activate active/archive without duplicate requests.</Criterion>
          <Criterion>The bridge and filterbar are restored when the viewport falls below 721 px.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/plans-lifecycle-desktop.test.mjs</Command></Verification>
      </T-003>
      <T-004>
        <Title>kafedra-tests and kafedra-design-audit: prove exact desktop behavior</Title>
        <DependsOn><T-003 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Desktop Playwright covers real active/archive API lists, preserved search, keyboard, target size, reduced motion and restoration below the breakpoint.</Criterion>
          <Criterion>Independent audit records no focus, contrast, geometry or state blocker.</Criterion>
          <Criterion>Full project CI remains successful.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npx playwright test tests/browser/plans-lifecycle-desktop.spec.mjs --project=desktop</Command><Command>npm test</Command></Verification>
      </T-004>
      <T-005>
        <Title>kafedra-release: exact-head squash merge, post-merge and terminal archive</Title>
        <DependsOn><T-004 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Every required exact-head check succeeds with no unresolved review thread.</Criterion>
          <Criterion>Post-merge CI succeeds before a separate archive-only applied transition.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run check</Command><Command>npm run docs:check</Command></Verification>
      </T-005>
    </ImplementationPlan>
