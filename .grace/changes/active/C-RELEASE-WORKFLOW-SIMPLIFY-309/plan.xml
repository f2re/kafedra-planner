      <File>tests/ci-simplification.test.mjs</File>
      <File>tests/grace-policy-combined-transition.test.mjs</File>
      <File>tests/release-workflow.test.mjs</File>
      <File>tests/release-recovery-workflow.test.mjs</File>
      <File>tests/release-assets-contract.test.mjs</File>
