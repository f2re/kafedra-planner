<GraceChangePlan graceVersion="4.0" status="approved">
  <C-RELEASE-WORKFLOW-SIMPLIFY-309>
    <IntentSummary>Collapse release automation into one explicit version-neutral workflow, remove cross-workflow orchestration and allow immutable GRACE bookkeeping to ride with the next governed change, while preserving exact-main, build-once, checksum, install/update/rollback and publication guarantees.</IntentSummary>
    <BaselineAssertions>
      <MustExist><Value>.github/workflows/release-gate.yml</Value></MustExist>
      <MustExist><Value>.github/workflows/release.yml</Value></MustExist>
      <MustExist><Value>scripts/offline/systemd-deploy-selftest.sh</Value></MustExist>
      <MustContain><File>.github/workflows/release-gate.yml</File><Text>Release gate 0.4.2</Text></MustContain>
      <MustContain><File>.github/workflows/release.yml</File><Text>workflow_run:</Text></MustContain>
      <MustContain><File>.github/workflows/release.yml</File><Text>gh workflow run</Text></MustContain>
      <MustVerify><Module>M-CI-GATE</Module></MustVerify>
      <MustVerify><Module>M-OFFLINE-BUNDLE</Module></MustVerify>
    </BaselineAssertions>
    <TargetAssertions>
      <MustExist><Value>.github/workflows/release.yml</Value></MustExist>
      <MustExist><Value>tests/release-workflow.test.mjs</Value></MustExist>
      <MustExist><Value>tests/release-recovery-workflow.test.mjs</Value></MustExist>
      <MustExist><Value>tests/grace-policy-combined-transition.test.mjs</Value></MustExist>
      <MustContain><File>.github/workflows/release.yml</File><Text>name: Release</Text></MustContain>
      <MustContain><File>.github/workflows/release.yml</File><Text>workflow_dispatch:</Text></MustContain>
      <MustContain><File>.github/workflows/release.yml</File><Text>systemd-deploy-selftest.sh "$OUT"</Text></MustContain>
      <MustContain><File>.github/workflows/release.yml</File><Text>build-full-bundle.sh</Text></MustContain>
      <MustContain><File>scripts/github/grace-policy-gate.mjs</File><Text>avoids a separate bookkeeping PR</Text></MustContain>
      <MustVerify><Module>M-CI-GATE</Module></MustVerify>
      <MustVerify><Module>M-OFFLINE-BUNDLE</Module></MustVerify>
    </TargetAssertions>
    <DurableScope>
      <GraphAnchors><M-CI-GATE /><M-OFFLINE-BUNDLE /><DF-GRACE-BRANCH /></GraphAnchors>
      <VerificationAnchors><V-M-CI-GATE /><V-M-OFFLINE-BUNDLE /></VerificationAnchors>
      <ContextArtifacts><ContextArtifact>deployment.xml</ContextArtifact><ContextArtifact>principles.xml</ContextArtifact></ContextArtifacts>
    </DurableScope>
    <ObservedWriteScope>
      <Glob>.grace/changes/active/C-RELEASE-WORKFLOW-SIMPLIFY-309/**</Glob>
      <Glob>.grace/changes/active/C-CI-SIMPLIFY-309/**</Glob>
      <Glob>.grace/changes/archive/C-CI-SIMPLIFY-309/**</Glob>
      <File>.github/workflows/release.yml</File>
      <File>.github/workflows/release-gate.yml</File>
      <File>README.md</File>
      <File>README.en.md</File>
