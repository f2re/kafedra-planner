    </ObservedWriteScope>
    <ImplementationPlan>
      <T-001>
        <Title>kafedra-release: freeze exact main and retire the completed CI change</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Base is exactly 12f93755be01e5f4dccec7b18d418db7ec119abd.</Criterion>
          <Criterion>C-CI-SIMPLIFY-309 moves from active approved to archive applied without changing its accepted content.</Criterion>
          <Criterion>The previous immutable terminal move may accompany this new governed change; a standalone archive-only PR is not required.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/grace-policy-combined-transition.test.mjs</Command></Verification>
      </T-001>
      <T-002>
        <Title>kafedra-release: replace chained release Actions with one workflow</Title>
        <DependsOn><T-001 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Release is manual-only, exact-main and version-neutral.</Criterion>
          <Criterion>Release gate is an internal job dependency, not another workflow.</Criterion>
          <Criterion>No external workflow polling, redispatch or sleep loop remains.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/release-workflow.test.mjs tests/release-recovery-workflow.test.mjs tests/release-decision.test.mjs</Command></Verification>
      </T-002>
      <T-003>
        <Title>kafedra-release: preserve build-once deployment evidence and publication safety</Title>
        <DependsOn><T-002 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>One full offline archive is built and verified.</Criterion>
          <Criterion>The same OUT directory passes systemd install/update/rollback before Project Control and upload.</Criterion>
          <Criterion>Tag/release creation is guarded by exact current main and seven checked assets.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/release-assets-contract.test.mjs</Command></Verification>
      </T-003>
      <T-004>
        <Title>kafedra-tests: align docs and regression contracts with the single release workflow</Title>
        <DependsOn><T-003 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>No current documentation or badge references deleted release-gate.yml.</Criterion>
          <Criterion>Historical 0.4.1/0.4.2 release notes remain historical and tests no longer force version-specific current workflow names.</Criterion>
          <Criterion>Ordinary CI contract still proves that release-scale work is absent from feature PRs.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run check</Command><Command>npm run docs:check</Command><Command>npm test</Command><Command>npm run smoke</Command></Verification>
      </T-004>
      <T-005>
        <Title>kafedra-release: exact-head PR validation and squash merge</Title>
        <DependsOn><T-004 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Only Проверка and risk-selected GRACE are required on the PR head.</Criterion>
          <Criterion>No manual Release workflow is started merely to merge the pipeline change.</Criterion>
          <Criterion>Exact-head mergeability and review comments are rechecked before squash merge.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run smoke</Command></Verification>
      </T-005>
    </ImplementationPlan>
  </C-RELEASE-WORKFLOW-SIMPLIFY-309>
