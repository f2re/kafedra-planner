      <MustContain><File>.github/workflows/grace.yml</File><Text>Run selected GRACE assertion gate</Text></MustContain>
      <MustVerify><Module>M-GRACE-GOVERNANCE</Module></MustVerify>
      <MustVerify><Module>M-CI-GATE</Module></MustVerify>
      <MustPassCommand><Command>node --test tests/grace-governance.test.mjs</Command></MustPassCommand>
