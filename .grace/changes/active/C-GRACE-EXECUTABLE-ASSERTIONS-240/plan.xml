      <MustContain><File>.github/workflows/grace.yml</File><Text>steps.assertion_env.outputs.playwright == 'true'</Text></MustContain>
      <MustContain><File>scripts/ci/grace-assertion-env.mjs</File><Text>playwright test</Text></MustContain>
      <MustContain><File>scripts/ci/grace-assertion-env.mjs</File><Text>GITHUB_OUTPUT</Text></MustContain>
