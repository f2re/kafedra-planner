    </ObservedWriteScope>
    <ImplementationPlan>
      <T-001>
        <Title>kafedra-release: define the executable assertion preparation contract</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Only selected baseline and final change gates prepare project dependencies.</Criterion>
          <Criterion>The selected active plan is the sole authority for whether a browser runtime is needed.</Criterion>
          <Criterion>Any preparation failure blocks assertions and no generated dependency state is committed.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/grace-assertion-env.test.mjs</Command></Verification>
      </T-001>
      <T-002>
        <Title>kafedra-feature: implement deterministic plan inspection and workflow preparation</Title>
        <DependsOn><T-001 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>The helper validates change ids, reads the exact active plan, decodes Command text and emits stable JSON or GitHub output.</Criterion>
          <Criterion>The workflow runs locked npm installation before assertions and installs Chromium only for detected Playwright commands.</Criterion>
          <Criterion>Current-mode GRACE lint remains lightweight and unchanged.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run check</Command></Verification>
      </T-002>
      <T-003>
        <Title>kafedra-tests: prove positive, negative and fail-closed detection cases</Title>
        <DependsOn><T-002 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Tests distinguish executable Command entries from prose and cover direct Playwright and npm browser invocations.</Criterion>
          <Criterion>Invalid ids and missing plans fail without path traversal.</Criterion>
          <Criterion>GitHub output is machine-readable and deterministic.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/grace-assertion-env.test.mjs</Command><Command>npm run docs:check</Command></Verification>
      </T-003>
      <T-004>
        <Title>kafedra-release: complete exact-head CI, squash merge and post-merge verification</Title>
        <DependsOn><T-003 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>GRACE final and every mandatory project check succeed for one unchanged PR head.</Criterion>
          <Criterion>The squash merge is followed by successful post-merge CI before an archive-only applied transition.</Criterion>
          <Criterion>PR 238 is updated from the new main only after this prerequisite is applied.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run check</Command><Command>npm run docs:check</Command></Verification>
      </T-004>
    </ImplementationPlan>
  </C-GRACE-EXECUTABLE-ASSERTIONS-240>
</GraceChangePlan>
