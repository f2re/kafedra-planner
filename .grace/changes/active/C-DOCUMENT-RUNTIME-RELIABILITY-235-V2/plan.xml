    <ImplementationPlan>
      <T-001>
        <Title>kafedra-flow-intake: preserve install, repair, upload and integration states</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Full install has explicit cache, package, full-preflight, control-OCR, application transaction and rollback states.</Criterion>
          <Criterion>Unicode normalization is invisible and Docomator failures retain entered connection context.</Criterion>
          <Criterion>One external integration or document failure never blocks local work or successful sibling items.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run docs:check</Command></Verification>
      </T-001>
      <T-002>
        <Title>kafedra-design and kafedra-motion: stable inline diagnostics with no-motion failure states</Title>
        <DependsOn><T-001 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Connection fields and status keep stable geometry on desktop/mobile and access code remains never-learn.</Criterion>
          <Criterion>Errors use inline text, readable wrapping and visible focus; no result depends on animation.</Criterion>
          <Criterion>Transport hashing has no user control because it must be transparent.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm run design:check</Command></Verification>
      </T-002>
      <T-003>
        <Title>kafedra-data and kafedra-release: immutable source identity and package-cache authority</Title>
        <DependsOn><T-002 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>No schema change; source bytes, Unicode name, SHA-256, document version and evidence remain authoritative.</Criterion>
          <Criterion>The cache identity derives from verified target profile and manifest digest and publishes atomically.</Criterion>
          <Criterion>The strict wrapper exits before invoking the application transaction whenever document runtime acceptance fails.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/http-headers.test.mjs tests/offline-package-policy.test.mjs tests/deploy-install-contract.test.mjs</Command></Verification>
      </T-003>
      <T-004>
        <Title>kafedra-feature: implement classified gateway errors, Unicode headers and strict modular activation</Title>
        <DependsOn><T-003 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Only classified Docomator failures cross the 5xx boundary; unknown server details remain private.</Criterion>
          <Criterion>A single imported helper canonicalizes upload identities before native Headers construction without changing source metadata.</Criterion>
          <Criterion>The wrapper verifies/caches payload, installs missing capabilities, runs full preflight and real OCR, then delegates to the unchanged readable application installer.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/http-headers.test.mjs tests/http-utils.test.mjs tests/docomator-integration.test.mjs tests/deploy-install-contract.test.mjs</Command></Verification>
      </T-004>
      <T-005>
        <Title>kafedra-design-audit and kafedra-tests: independently verify responsive errors and release recovery</Title>
        <DependsOn><T-004 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Design audit records desktop, mobile, keyboard, focus and reduced-motion results with no unresolved blocker.</Criterion>
          <Criterion>Unit/integration/browser tests cover Unicode, safe 5xx serialization, every network category, strict activation, retained repair and repeated execution.</Criterion>
          <Criterion>Full CI contains no production mock, silent degraded full install or duplicate object.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npm test</Command><Command>npx playwright test tests/browser/docomator-integration.spec.mjs tests/browser/unicode-upload-headers.spec.mjs</Command></Verification>
      </T-005>
