    <ImplementationPlan>
      <T-001>
        <Title>kafedra-design: keep reprocess as a secondary exception action</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Desktop and mobile protocol-import rows keep the existing primary Open/Исправить action and expose reprocess only for failed or needs-review processing states.</Criterion>
          <Criterion>The action uses the saved source and is labelled in plain Russian without asking the user for OCR settings.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npx playwright test tests/browser/protocol-import.spec.mjs</Command></Verification>
      </T-001>
      <T-002>
        <Title>kafedra-motion: use no-motion for the retry control</Title>
        <DependsOn><T-001 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>No new animation is introduced; focus remains on the row/action and existing prefers-reduced-motion behavior is unchanged.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npx playwright test tests/browser/protocol-import.spec.mjs</Command></Verification>
      </T-002>
      <T-003>
        <Title>kafedra-feature: implement page provenance, partial coverage and same-version reprocess</Title>
        <DependsOn><T-002 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Per-image OCR always maps to the supplied absolute source page in JS and Python.</Criterion>
          <Criterion>Native PDF blocks are evaluated per page and weak pages are OCRed and merged without replacing useful native pages.</Criterion>
          <Criterion>OCR diagnostics expose page coverage and partial/truncated outcomes.</Criterion>
          <Criterion>POST document reprocess enforces edit access when ACL is enabled, queues the current version idempotently, and preserves immutable source/history.</Criterion>
          <Criterion>The worker creates a fresh extraction run and existing domain materializers prevent duplicate meetings or destructive field replacement.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/ocr-tsv.test.mjs tests/ocr-coverage.test.mjs tests/document-reprocess.test.mjs tests/protocol-year-import.test.mjs</Command><Command>python3 -m py_compile scripts/recognition/ocr.py</Command></Verification>
      </T-003>
      <T-004>
        <Title>kafedra-design-audit: verify exception-first retry flow</Title>
        <DependsOn><T-003 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Ready imports do not gain an unnecessary retry action; failed/needs-review rows have one clear recoverable action and retain Original/Open.</Criterion>
          <Criterion>Keyboard activation and desktop/mobile layout remain usable without modal or motion additions.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>npx playwright test tests/browser/protocol-import.spec.mjs</Command></Verification>
      </T-004>
      <T-005>
        <Title>kafedra-tests: prove provenance, partial success and idempotency</Title>
        <DependsOn><T-004 /></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Tests fail on the original page_num=1 bug and pass only with locators 1/2/3.</Criterion>
          <Criterion>Mixed-PDF and failed-page cases keep good blocks and report incomplete coverage.</Criterion>
          <Criterion>Repeated active reprocess requests do not create duplicate jobs/documents/meetings and old extraction runs remain queryable.</Criterion>
        </AcceptanceCriteria>
        <Verification><Command>node --test tests/ocr-tsv.test.mjs tests/ocr-coverage.test.mjs tests/document-reprocess.test.mjs tests/protocol-year-import.test.mjs</Command><Command>npx playwright test tests/browser/protocol-import.spec.mjs</Command></Verification>
      </T-005>
    </ImplementationPlan>
  </C-R1-OCR-REPROCESS-319>
