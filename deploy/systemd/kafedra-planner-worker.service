[Unit]
Description=Kafedra Planner Worker
After=kafedra-planner-api.service

[Service]
Type=simple
User=kafedra-planner
Group=kafedra-planner
EnvironmentFile=-/etc/kafedra-planner/kafedra-planner.env
WorkingDirectory=/opt/kafedra-planner/current
ExecStart=/opt/kafedra-planner/current/runtime/node/bin/node apps/worker/src/main.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kafedra-planner /var/backups/kafedra-planner
UMask=0077

[Install]
WantedBy=multi-user.target
