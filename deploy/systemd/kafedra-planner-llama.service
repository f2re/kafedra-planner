[Unit]
Description=Kafedra Planner local llama.cpp server
After=local-fs.target
Before=kafedra-planner-worker.service

[Service]
Type=simple
User=kafedra-planner
Group=kafedra-planner
EnvironmentFile=-/etc/kafedra-planner/kafedra-planner.env
WorkingDirectory=/opt/kafedra-planner/current
ExecStart=/opt/kafedra-planner/current/scripts/offline/run-llama-server.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/var/lib/kafedra-planner/models
UMask=0077

[Install]
WantedBy=multi-user.target
