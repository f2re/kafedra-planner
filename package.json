{
  "name": "kafedra-planner",
  "version": "0.1.0-rc.2",
  "private": true,
  "description": "Автономная платформа календаря, документов, решений, сроков и деятельности кафедры.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node apps/api/src/main.mjs",
    "worker": "node apps/worker/src/main.mjs",
    "dev": "node --watch apps/api/src/main.mjs",
    "dev:worker": "node --watch apps/worker/src/main.mjs",
    "migrate": "node scripts/migrate.mjs",
    "auth:create-admin": "node scripts/create-admin.mjs",
    "backup:create": "node scripts/backup-create.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "backup:restore": "node scripts/backup-restore.mjs",
    "backup:selftest": "node scripts/backup-selftest.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:browser": "playwright test",
    "test:browser:reports-science": "playwright test --config=playwright.reports-science.config.mjs",
    "test:browser:plan-fact": "playwright test --config=playwright.plan-fact.config.mjs && playwright test --config=playwright.plan-fact-tools.config.mjs",
    "test:browser:plan-fact-tools": "playwright test --config=playwright.plan-fact-tools.config.mjs",
    "test:browser:auth": "playwright test --config=playwright.auth.config.mjs",
    "test:browser:release": "playwright test --config=playwright.release.config.mjs",
    "bundle:offline": "bash scripts/offline/build-bundle.sh",
    "bundle:verify": "bash scripts/offline/verify-bundle.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
